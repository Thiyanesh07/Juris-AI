# =============================================================================
# JURIS AI BACKEND (FASTAPI) — ENVIRONMENT CONFIGURATION
# =============================================================================
SESSION_SECRET=replace-with-a-long-random-secret-key
DATABASE_URL=postgresql+asyncpg://legalgraph:replace-with-local-postgres-password@localhost:5434/legalgraph
FRONTEND_URL=http://localhost:3001
SESSION_COOKIE_SECURE=false

# Google OAuth (Backend server-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Graph Knowledge Store & Retrieval
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# LLM Provider Configuration
LLM_PROVIDER=google_genai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=45.0
