# =============================================================================
# JURIS AI — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or .env.local to version control.
#
# Google Cloud OAuth Credential Type Required:
#   OAuth 2.0 Client ID — "Web application" type
#   (NOT "Desktop app" or "Installed application")
#
# Required Authorized Redirect URI (add in Google Cloud Console):
#   Local development: http://localhost:3001/auth/google/callback
#   (This matches the admin portal Google OAuth callback route)
#
# For user portal sign-in, the redirect URI is:
#   Local development: http://localhost:3002/auth/google/callback
#
# Both URIs must be added to your Google Cloud Console OAuth client's
# "Authorized redirect URIs" list.
# =============================================================================

# ----------------------------------------------------------------------------
# Backend (FastAPI) — runs on :8000
# ----------------------------------------------------------------------------
# A cryptographically random secret key (minimum 32 characters).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-secret-key

# PostgreSQL connection string (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://legalgraph:replace-with-local-postgres-password@localhost:5434/legalgraph

# The public URL of the admin portal frontend (used to build the OAuth redirect URI)
FRONTEND_URL=http://localhost:3001

# Set to true in production (requires HTTPS)
SESSION_COOKIE_SECURE=false

# ----------------------------------------------------------------------------
# Google OAuth — Web Application client credentials
# NEVER expose GOOGLE_CLIENT_SECRET in any client-side Next.js code.
# The backend (server/api) reads these; clients only read NEXT_PUBLIC_*.
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ----------------------------------------------------------------------------
# Client — Admin Portal (client/admin) — runs on :3001
# ----------------------------------------------------------------------------
# The public URL of the backend API. Readable by Next.js server-side code only.
# Do NOT prefix with NEXT_PUBLIC_ if you want it server-only.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The Google Client ID is safe to expose publicly (it is not a secret).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ----------------------------------------------------------------------------
# Client — User Portal (client/user) — runs on :3002
# (same values as above; set in client/user/.env.local separately)
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Client — Landing Page (client/landing) — runs on :3000
# (same values as above; set in client/landing/.env.local separately)
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Neo4j (Phase 11+, not required for Phase 10.5)
# ----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ----------------------------------------------------------------------------
# LLM Provider (Phase 11+, not required for Phase 10.5)
# ----------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
